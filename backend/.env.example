# FastAPI
DEBUG=False
API_TITLE="🌾 AgroGuard API"
API_VERSION="1.0.0"

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agroguard

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ML Models
MODEL_PATH=/ml/models/model_v2.pt
KB_PATH=../ml/knowledge_base/diseases.json



# ML MODELS & DATA PATHS
# ============================================
YOLO_MODEL_PATH=ml/models/model_v1.pt
VIT_MODEL_PATH=../ml/models/vit/model.pth
LSTM_MODEL_PATH=../ml/models/lstm/forecaster.pth
KNOWLEDGE_BASE_PATH=../ml/knowledge_base/diseases.json

# LLM Configuration
DEFAULT_LLM=openai
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# LLM API Keys
OPENAI_API_KEY=sk-...
AIPIPE_API_KEY=...
OPENROUTER_API_KEY=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

# Security
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Twilio WhatsApp Notifications (Optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
